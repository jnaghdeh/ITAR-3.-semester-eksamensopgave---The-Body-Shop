<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Fase1_Vagtplan_AS_IS" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:error id="Error_OversetLovbrud" name="Overset lovbrud eller manglende nøglebærer" errorCode="ERR_COMPLIANCE_VIOLATION" />
  <bpmn:collaboration id="Collaboration_Fase1_Vagtplan_AS_IS">
    <bpmn:participant id="Participant_WhatsApp" name="WhatsApp (Privat beskedapp og gruppechat)" />
    <bpmn:participant id="Participant_TheBodyShop_F1" name="Udarbejdelse og udgivelse af vagtplan (AS-IS)" processRef="Process_Fase1_Vagtplan_AS_IS" />
    <bpmn:messageFlow id="MsgFlow_OenskerWhatsApp" name="Ustrukturerede ønsker, ferie &#38; utilgængelighed" sourceRef="Participant_WhatsApp" targetRef="Activity_IndsamlOensker" />
    <bpmn:messageFlow id="MsgFlow_BilledeVagtplan" name="Billede af månedens fysiske papirkalender" sourceRef="Activity_SendBillede" targetRef="Participant_WhatsApp" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Fase1_Vagtplan_AS_IS" name="Udarbejdelse og udgivelse af vagtplan (AS-IS)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_F1">
      <bpmn:lane id="Lane_Butikschef" name="Butikschef">
        <bpmn:flowNodeRef>StartEvent_Fase1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_IndsamlOensker</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_UdarbejdPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_KontrollerRegler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryError_OversetRegelbrud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_UlovligPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Regelbrud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RetKabale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_OphaengKalender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_SendBillede</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PlanUdgivet</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Fase1" name="Planlægningsperiode startet (ca. 4 uger før)">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_F1" />
    </bpmn:startEvent>
    <bpmn:receiveTask id="Activity_IndsamlOensker" name="Indsaml ønsker, ferie og utilgængelighed">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:manualTask id="Activity_UdarbejdPlan" name="Udarbejd vagtplan på papirkalender">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_Udarbejd">
        <bpmn:targetRef>DataObjectRef_Papirkalender</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="Activity_KontrollerRegler" name="Kontrollér lovregler og kompetencer manuelt">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:property id="Property_Regler" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssoc_Regler">
        <bpmn:sourceRef>DataStoreRef_LovOgKompetencer</bpmn:sourceRef>
        <bpmn:targetRef>Property_Regler</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:boundaryEvent id="BoundaryError_OversetRegelbrud" name="Regelbrud overset" attachedToRef="Activity_KontrollerRegler">
      <bpmn:outgoing>Flow_Error_Lovbrud</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDef_Boundary_Lovbrud" errorRef="Error_OversetLovbrud" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="EndEvent_UlovligPlan" name="Ulovlig vagtkombination / manglende nøglebærer">
      <bpmn:incoming>Flow_Error_Lovbrud</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDef_End_Lovbrud" errorRef="Error_OversetLovbrud" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Regelbrud" name="Regelbrud fundet?">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_Nej</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Activity_RetKabale" name="Ret vagtkabale manuelt på papir">
      <bpmn:incoming>Flow_Ja</bpmn:incoming>
      <bpmn:outgoing>Flow_Rettet</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_MergePlan">
      <bpmn:incoming>Flow_Nej</bpmn:incoming>
      <bpmn:incoming>Flow_Rettet</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Activity_OphaengKalender" name="Ophæng papirkalender i baglokale">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_Ophaeng">
        <bpmn:targetRef>DataObjectRef_Papirkalender</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:sendTask id="Activity_SendBillede" name="Send billede af vagtplan i WhatsApp">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_PlanUdgivet" name="Månedsvagtplan offentliggjort">
      <bpmn:incoming>Flow_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStoreRef_LovOgKompetencer" name="Arbejdstidsregler (11t, 48t, fridøgn, pause) &#38; kompetencer (tavs viden)" />
    <bpmn:dataObject id="DataObject_Papirkalender" />
    <bpmn:dataObjectReference id="DataObjectRef_Papirkalender" name="Fysisk papirkalender (baglokale)" dataObjectRef="DataObject_Papirkalender" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Fase1" targetRef="Activity_IndsamlOensker" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Activity_IndsamlOensker" targetRef="Activity_UdarbejdPlan" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Activity_UdarbejdPlan" targetRef="Activity_KontrollerRegler" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Activity_KontrollerRegler" targetRef="Gateway_Regelbrud" />
    <bpmn:sequenceFlow id="Flow_Error_Lovbrud" sourceRef="BoundaryError_OversetRegelbrud" targetRef="EndEvent_UlovligPlan" />
    <bpmn:sequenceFlow id="Flow_Ja" name="Ja" sourceRef="Gateway_Regelbrud" targetRef="Activity_RetKabale" />
    <bpmn:sequenceFlow id="Flow_Nej" name="Nej" sourceRef="Gateway_Regelbrud" targetRef="Gateway_MergePlan" />
    <bpmn:sequenceFlow id="Flow_Rettet" sourceRef="Activity_RetKabale" targetRef="Gateway_MergePlan" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_MergePlan" targetRef="Activity_OphaengKalender" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Activity_OphaengKalender" targetRef="Activity_SendBillede" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Activity_SendBillede" targetRef="EndEvent_PlanUdgivet" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_F1">
    <bpmndi:BPMNPlane id="BPMNPlane_F1" bpmnElement="Collaboration_Fase1_Vagtplan_AS_IS">
