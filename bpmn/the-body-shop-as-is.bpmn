<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_TheBodyShop_AS_IS" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:error id="Error_OversetLovbrud" name="Overset lovbrud eller manglende nøglebærer" errorCode="ERR_COMPLIANCE_VIOLATION" />
  <bpmn:error id="Error_TastefejlLoen" name="Tastefejl eller ulæselig håndskrift i løngrundlag" errorCode="ERR_PAYROLL_INPUT" />
  <bpmn:collaboration id="Collaboration_TheBodyShop_AS_IS">
    <bpmn:participant id="Participant_WhatsApp" name="WhatsApp (Privat beskedapp og ustruktureret gruppechat)" />
    <bpmn:participant id="Participant_TheBodyShop" name="Vagtplanlægning, vagtbytte og tidsregistrering – The Body Shop (AS-IS)" processRef="Process_TheBodyShop_AS_IS" />
    <bpmn:participant id="Participant_SalaryDK" name="salary.dk (Eksternt lønsystem)" />
    <bpmn:messageFlow id="MsgFlow_OenskerWhatsApp" name="Ustrukturerede ønsker, ferie &#38; utilgængelighed" sourceRef="Participant_WhatsApp" targetRef="Activity_PROC_01" />
    <bpmn:messageFlow id="MsgFlow_BilledeVagtplan" name="Billede af månedens fysiske papirkalender" sourceRef="Activity_PROC_06" targetRef="Participant_WhatsApp" />
    <bpmn:messageFlow id="MsgFlow_EfterspoergBytte" name="Vagtbytte-forespørgsel i gruppechat" sourceRef="Activity_PROC_07" targetRef="Participant_WhatsApp" />
    <bpmn:messageFlow id="MsgFlow_SvarBytte" name="Svar &#38; aftale i WhatsApp-tråd" sourceRef="Participant_WhatsApp" targetRef="Activity_PROC_08" />
    <bpmn:messageFlow id="MsgFlow_SygdomWhatsApp" name="Opfølgende sygdomsbesked for at hjælpe" sourceRef="Activity_PROC_10" targetRef="Participant_WhatsApp" />
    <bpmn:messageFlow id="MsgFlow_BydIndAkut" name="Koordinering af akut vagtdækning" sourceRef="Participant_WhatsApp" targetRef="Activity_PROC_11" />
    <bpmn:messageFlow id="MsgFlow_BekraeftelseWhatsApp" name="Tekstbekræftelse (risiko for forældede billeder)" sourceRef="Activity_PROC_14" targetRef="Participant_WhatsApp" />
    <bpmn:messageFlow id="MsgFlow_SalaryDK" name="Manuel indtastning af optalte timer &#38; afvigelser" sourceRef="Activity_PROC_17" targetRef="Participant_SalaryDK" />
    <bpmn:group id="Group_Fase1" categoryValueRef="CategoryValue_Fase1" />
    <bpmn:group id="Group_Fase2" categoryValueRef="CategoryValue_Fase2" />
    <bpmn:group id="Group_Fase3" categoryValueRef="CategoryValue_Fase3" />
  </bpmn:collaboration>
  <bpmn:category id="Category_Fase1">
    <bpmn:categoryValue id="CategoryValue_Fase1" value="Fase 1: Udarbejdelse og udgivelse af vagtplan (Månedlig)" />
  </bpmn:category>
  <bpmn:category id="Category_Fase2">
    <bpmn:categoryValue id="CategoryValue_Fase2" value="Fase 2: Vagtbytte, akut sygdom og driftskommunikation (Løbende)" />
  </bpmn:category>
  <bpmn:category id="Category_Fase3">
    <bpmn:categoryValue id="CategoryValue_Fase3" value="Fase 3: Tidsregistrering og klargøring til løn (Månedsslut)" />
  </bpmn:category>
  <bpmn:process id="Process_TheBodyShop_AS_IS" name="Vagtplanlægning, vagtbytte og tidsregistrering – The Body Shop (AS-IS)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TheBodyShop">
      <bpmn:lane id="Lane_Butikschef" name="Butikschef">
        <bpmn:flowNodeRef>StartEvent_Fase1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryError_OversetRegelbrud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_UlovligPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Konflikt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PlanUdgivet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Godkendt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_BytteAfvist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_VagtOpdateret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Maanedsslut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryError_Tastefejl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Loenfejl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_LoenKlargjort</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Butiksmedarbejder" name="Butiksmedarbejder (Fuldtid / Deltid 18+)">
        <bpmn:flowNodeRef>StartEvent_Fase2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DriftType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_IngenBytte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_Fase3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_15</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kollega" name="Kollega / Øvrigt butiksteam">
        <bpmn:flowNodeRef>Activity_PROC_08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryTimer_IntetSvar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeDrift</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Fase1" name="Planlægningsperiode startet (ca. 4 uger før)">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
      <bpmn:outgoing>Flow_F1_01</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_F1" />
    </bpmn:startEvent>
    <bpmn:receiveTask id="Activity_PROC_01" name="PROC-01: Indsaml ønsker, ferie og utilgængelighed [NNVA]">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F1_01</bpmn:incoming>
      <bpmn:outgoing>Flow_F1_02</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:manualTask id="Activity_PROC_02" name="PROC-02: Udarbejd vagtplan på papirkalender [VA]">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F1_02</bpmn:incoming>
      <bpmn:outgoing>Flow_F1_03</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_F1_Plan">
        <bpmn:targetRef>DataObjectRef_Papirkalender1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="Activity_PROC_03" name="PROC-03: Kontrollér lovregler og kompetencer manuelt [NVA]">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F1_03</bpmn:incoming>
      <bpmn:outgoing>Flow_F1_04</bpmn:outgoing>
      <bpmn:property id="Property_F1_03" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssoc_F1_Regler">
        <bpmn:sourceRef>DataStoreRef_LovOgKompetencer</bpmn:sourceRef>
        <bpmn:targetRef>Property_F1_03</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:boundaryEvent id="BoundaryError_OversetRegelbrud" name="Regelbrud overset" attachedToRef="Activity_PROC_03">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
      <bpmn:outgoing>Flow_F1_Error</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDef_Boundary_Lovbrud" errorRef="Error_OversetLovbrud" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="EndEvent_UlovligPlan" name="Ulovlig vagtkombination / manglende nøglebærer">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F1_Error</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDef_End_Lovbrud" errorRef="Error_OversetLovbrud" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Konflikt" name="Regelbrud fundet?">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F1_04</bpmn:incoming>
      <bpmn:outgoing>Flow_F1_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_F1_Nej</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Activity_PROC_04" name="PROC-04: Ret vagtkabale manuelt på papir [NVA]">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F1_Ja</bpmn:incoming>
      <bpmn:outgoing>Flow_F1_Rettet</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_MergePlan">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F1_Nej</bpmn:incoming>
      <bpmn:incoming>Flow_F1_Rettet</bpmn:incoming>
      <bpmn:outgoing>Flow_F1_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Activity_PROC_05" name="PROC-05: Ophæng papirkalender i baglokale [VA]">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F1_05</bpmn:incoming>
      <bpmn:outgoing>Flow_F1_06</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_F1_Ophaeng">
        <bpmn:targetRef>DataObjectRef_Papirkalender1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:sendTask id="Activity_PROC_06" name="PROC-06: Send billede af vagtplan i WhatsApp [VA]">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F1_06</bpmn:incoming>
      <bpmn:outgoing>Flow_F1_07</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_PlanUdgivet" name="Månedsvagtplan offentliggjort">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F1_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent_Fase2" name="Behov for vagtændring opstået">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:outgoing>Flow_F2_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_DriftType" name="Vagtbytte eller akut sygdom?">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F2_01</bpmn:incoming>
      <bpmn:outgoing>Flow_F2_Vagtbytte</bpmn:outgoing>
      <bpmn:outgoing>Flow_F2_AkutSygdom</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_PROC_07" name="PROC-07: Send forespørgsel om vagtbytte i WhatsApp [NVA]">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F2_Vagtbytte</bpmn:incoming>
      <bpmn:outgoing>Flow_F2_07_08</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_PROC_08" name="PROC-08: Afvent svar og aftal vagtbytte i WhatsApp [NVA]">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F2_07_08</bpmn:incoming>
      <bpmn:outgoing>Flow_F2_08_Merge</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="BoundaryTimer_IntetSvar" name="Intet svar / druknet i chat" attachedToRef="Activity_PROC_08">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:outgoing>Flow_F2_Timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDef_IntetSvar" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="EndEvent_IngenBytte" name="Vagtbytte ikke gennemført">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F2_Timeout</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="Activity_PROC_09" name="PROC-09: Ring til butikschef og meld sygdom [NNVA]">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F2_AkutSygdom</bpmn:incoming>
      <bpmn:outgoing>Flow_F2_09_10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="Activity_PROC_10" name="PROC-10: Skriv i WhatsApp for at hjælpe med dækning [NVA]">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F2_09_10</bpmn:incoming>
      <bpmn:outgoing>Flow_F2_10_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_PROC_11" name="PROC-11: Koordinér og byd ind på akut vagt [NNVA]">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F2_10_11</bpmn:incoming>
      <bpmn:outgoing>Flow_F2_11_Merge</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_MergeDrift">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F2_08_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_F2_11_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_F2_TilChef</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Activity_PROC_12" name="PROC-12: Tjek kompetencer og lovkrav manuelt [NNVA]">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F2_TilChef</bpmn:incoming>
      <bpmn:outgoing>Flow_F2_12_Gw</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_Godkendt" name="Overholder krav og godkendt?">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F2_12_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_F2_Nej_Afvist</bpmn:outgoing>
      <bpmn:outgoing>Flow_F2_Ja_Godkendt</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_BytteAfvist" name="Vagtændring afvist">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F2_Nej_Afvist</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="Activity_PROC_13" name="PROC-13: Ret fysisk papirkalender manuelt [NVA]">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F2_Ja_Godkendt</bpmn:incoming>
      <bpmn:outgoing>Flow_F2_13_14</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_F2_Ret">
        <bpmn:targetRef>DataObjectRef_Papirkalender2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:sendTask id="Activity_PROC_14" name="PROC-14: Bekræft ændring i WhatsApp (dobbeltarbejde) [NVA]">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F2_13_14</bpmn:incoming>
      <bpmn:outgoing>Flow_F2_14_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_VagtOpdateret" name="Vagtplan opdateret manuelt">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F2_14_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent_Fase3" name="Vagt afholdt eller afvigelse opstået">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:outgoing>Flow_F3_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="Activity_PROC_15" name="PROC-15: Notér faktiske timer og afvigelser med håndskrift [NNVA]">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F3_01</bpmn:incoming>
      <bpmn:outgoing>Flow_F3_02</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_F3_Noter">
        <bpmn:targetRef>DataObjectRef_Papirkalender3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="Event_Maanedsslut" name="Lønperiode afsluttet (den 1.–31.)">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F3_02</bpmn:incoming>
      <bpmn:outgoing>Flow_F3_03</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDef_Maanedsslut" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Activity_PROC_16" name="PROC-16: Optæl månedens timer manuelt fra papir [NVA]">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F3_03</bpmn:incoming>
      <bpmn:outgoing>Flow_F3_04</bpmn:outgoing>
      <bpmn:property id="Property_F3_16" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssoc_F3_Optael">
        <bpmn:sourceRef>DataObjectRef_Papirkalender3</bpmn:sourceRef>
        <bpmn:targetRef>Property_F3_16</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="Activity_PROC_17" name="PROC-17: Indtast timer enkeltvis i salary.dk [NVA]">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F3_04</bpmn:incoming>
      <bpmn:outgoing>Flow_F3_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BoundaryError_Tastefejl" name="Tastefejl / ulæselig håndskrift" attachedToRef="Activity_PROC_17">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:outgoing>Flow_F3_Error</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDef_Boundary_Loen" errorRef="Error_TastefejlLoen" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="EndEvent_Loenfejl" name="Forkert løngrundlag / mangelfuld dokumentation">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F3_Error</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDef_End_Loen" errorRef="Error_TastefejlLoen" />
    </bpmn:endEvent>
    <bpmn:manualTask id="Activity_PROC_18" name="PROC-18: Udskift fysisk papirkalender ved månedsskifte [NVA]">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F3_05</bpmn:incoming>
      <bpmn:outgoing>Flow_F3_06</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="EndEvent_LoenKlargjort" name="Løngrundlag indtastet i salary.dk">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_F3_06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStoreRef_LovOgKompetencer" name="Arbejdstidsregler (11t, 48t, fridøgn, pause) &#38; kompetencer (tavs viden)">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
    </bpmn:dataStoreReference>
    <bpmn:dataObject id="DataObject_Papirkalender" />
    <bpmn:dataObjectReference id="DataObjectRef_Papirkalender1" name="Fysisk papirkalender (baglokale)" dataObjectRef="DataObject_Papirkalender">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
    </bpmn:dataObjectReference>
    <bpmn:dataObjectReference id="DataObjectRef_Papirkalender2" name="Fysisk papirkalender (rettet manuelt)" dataObjectRef="DataObject_Papirkalender">
