<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Fase2_Vagtbytte_Sygdom_AS_IS" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:collaboration id="Collaboration_Fase2_Vagtbytte_AS_IS">
    <bpmn:participant id="Participant_WhatsApp" name="WhatsApp (Privat beskedapp og gruppechat)" />
    <bpmn:participant id="Participant_TheBodyShop_F2" name="Vagtbytte, akut sygdom og driftskommunikation (AS-IS)" processRef="Process_Fase2_Vagtbytte_AS_IS" />
    <bpmn:messageFlow id="MsgFlow_EfterspoergBytte" name="Vagtbytte-forespørgsel i gruppechat" sourceRef="Activity_SendBytteForespoergsel" targetRef="Participant_WhatsApp" />
    <bpmn:messageFlow id="MsgFlow_SygdomWhatsApp" name="Opfølgende sygdomsbesked for at hjælpe" sourceRef="Activity_SkrivWhatsAppSyg" targetRef="Participant_WhatsApp" />
    <bpmn:messageFlow id="MsgFlow_BydIndAkut" name="Koordinering af akut vagtdækning" sourceRef="Participant_WhatsApp" targetRef="Activity_KoordinerAkut" />
    <bpmn:messageFlow id="MsgFlow_SvarBytte" name="Svar &#38; aftale i WhatsApp-tråd" sourceRef="Participant_WhatsApp" targetRef="Activity_AfventSvarBytte" />
    <bpmn:messageFlow id="MsgFlow_BekraeftelseWhatsApp" name="Tekstbekræftelse (risiko for forældede billeder)" sourceRef="Activity_BekraeftWhatsApp" targetRef="Participant_WhatsApp" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Fase2_Vagtbytte_AS_IS" name="Vagtbytte, akut sygdom og driftskommunikation (AS-IS)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_F2">
      <bpmn:lane id="Lane_Butiksmedarbejder" name="Butiksmedarbejder (Fuldtid / Deltid 18+)">
        <bpmn:flowNodeRef>StartEvent_Fase2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DriftType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_SendBytteForespoergsel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RingChef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_SkrivWhatsAppSyg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_IngenBytte</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kollega" name="Kollega / Øvrigt butiksteam">
        <bpmn:flowNodeRef>Activity_AfventSvarBytte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryTimer_IntetSvar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_KoordinerAkut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeDrift</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Butikschef" name="Butikschef">
        <bpmn:flowNodeRef>Activity_TjekKompetencer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Godkendt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_BytteAfvist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RetKalender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_BekraeftWhatsApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_VagtOpdateret</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Fase2" name="Behov for vagtændring opstået">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_DriftType" name="Vagtbytte eller akut sygdom?">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_Vagtbytte</bpmn:outgoing>
      <bpmn:outgoing>Flow_AkutSygdom</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_SendBytteForespoergsel" name="Send forespørgsel om vagtbytte i WhatsApp">
      <bpmn:incoming>Flow_Vagtbytte</bpmn:incoming>
      <bpmn:outgoing>Flow_Bytte_Afvent</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:manualTask id="Activity_RingChef" name="Ring til butikschef og meld sygdom">
      <bpmn:incoming>Flow_AkutSygdom</bpmn:incoming>
      <bpmn:outgoing>Flow_Ring_WhatsApp</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="Activity_SkrivWhatsAppSyg" name="Skriv i WhatsApp for at hjælpe med dækning">
      <bpmn:incoming>Flow_Ring_WhatsApp</bpmn:incoming>
      <bpmn:outgoing>Flow_Syg_Akut</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_IngenBytte" name="Vagtbytte ikke gennemført">
      <bpmn:incoming>Flow_Timeout</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="Activity_AfventSvarBytte" name="Afvent svar og aftal vagtbytte i WhatsApp">
      <bpmn:incoming>Flow_Bytte_Afvent</bpmn:incoming>
      <bpmn:outgoing>Flow_Bytte_Merge</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="BoundaryTimer_IntetSvar" name="Intet svar / druknet i chat" attachedToRef="Activity_AfventSvarBytte">
      <bpmn:outgoing>Flow_Timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDef_IntetSvar" />
    </bpmn:boundaryEvent>
    <bpmn:receiveTask id="Activity_KoordinerAkut" name="Koordinér og byd ind på akut vagt">
      <bpmn:incoming>Flow_Syg_Akut</bpmn:incoming>
      <bpmn:outgoing>Flow_Akut_Merge</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_MergeDrift">
      <bpmn:incoming>Flow_Bytte_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_Akut_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_TilChef</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Activity_TjekKompetencer" name="Tjek kompetencer og lovkrav manuelt">
      <bpmn:incoming>Flow_TilChef</bpmn:incoming>
      <bpmn:outgoing>Flow_Tjek_Gw</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_Godkendt" name="Overholder krav og godkendt?">
      <bpmn:incoming>Flow_Tjek_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Nej_Afvist</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ja_Godkendt</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_BytteAfvist" name="Vagtændring afvist">
      <bpmn:incoming>Flow_Nej_Afvist</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="Activity_RetKalender" name="Ret fysisk papirkalender manuelt">
      <bpmn:incoming>Flow_Ja_Godkendt</bpmn:incoming>
      <bpmn:outgoing>Flow_Ret_Bekraeft</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_Ret">
        <bpmn:targetRef>DataObjectRef_Papirkalender2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:sendTask id="Activity_BekraeftWhatsApp" name="Bekræft ændring i WhatsApp">
      <bpmn:incoming>Flow_Ret_Bekraeft</bpmn:incoming>
      <bpmn:outgoing>Flow_Bekraeft_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_VagtOpdateret" name="Vagtplan opdateret manuelt">
      <bpmn:incoming>Flow_Bekraeft_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="DataObject_Papirkalender2" />
    <bpmn:dataObjectReference id="DataObjectRef_Papirkalender2" name="Fysisk papirkalender (rettet manuelt)" dataObjectRef="DataObject_Papirkalender2" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Fase2" targetRef="Gateway_DriftType" />
    <bpmn:sequenceFlow id="Flow_Vagtbytte" name="Vagtbytte" sourceRef="Gateway_DriftType" targetRef="Activity_SendBytteForespoergsel" />
    <bpmn:sequenceFlow id="Flow_AkutSygdom" name="Akut sygdom" sourceRef="Gateway_DriftType" targetRef="Activity_RingChef" />
    <bpmn:sequenceFlow id="Flow_Bytte_Afvent" sourceRef="Activity_SendBytteForespoergsel" targetRef="Activity_AfventSvarBytte" />
    <bpmn:sequenceFlow id="Flow_Timeout" sourceRef="BoundaryTimer_IntetSvar" targetRef="EndEvent_IngenBytte" />
    <bpmn:sequenceFlow id="Flow_Bytte_Merge" sourceRef="Activity_AfventSvarBytte" targetRef="Gateway_MergeDrift" />
    <bpmn:sequenceFlow id="Flow_Ring_WhatsApp" sourceRef="Activity_RingChef" targetRef="Activity_SkrivWhatsAppSyg" />
    <bpmn:sequenceFlow id="Flow_Syg_Akut" sourceRef="Activity_SkrivWhatsAppSyg" targetRef="Activity_KoordinerAkut" />
    <bpmn:sequenceFlow id="Flow_Akut_Merge" sourceRef="Activity_KoordinerAkut" targetRef="Gateway_MergeDrift" />
    <bpmn:sequenceFlow id="Flow_TilChef" sourceRef="Gateway_MergeDrift" targetRef="Activity_TjekKompetencer" />
    <bpmn:sequenceFlow id="Flow_Tjek_Gw" sourceRef="Activity_TjekKompetencer" targetRef="Gateway_Godkendt" />
    <bpmn:sequenceFlow id="Flow_Nej_Afvist" name="Nej" sourceRef="Gateway_Godkendt" targetRef="EndEvent_BytteAfvist" />
    <bpmn:sequenceFlow id="Flow_Ja_Godkendt" name="Ja" sourceRef="Gateway_Godkendt" targetRef="Activity_RetKalender" />
    <bpmn:sequenceFlow id="Flow_Ret_Bekraeft" sourceRef="Activity_RetKalender" targetRef="Activity_BekraeftWhatsApp" />
    <bpmn:sequenceFlow id="Flow_Bekraeft_End" sourceRef="Activity_BekraeftWhatsApp" targetRef="EndEvent_VagtOpdateret" />
  </bpmn:process>
