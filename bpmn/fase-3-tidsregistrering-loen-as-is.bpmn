      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryError_Tastefejl_di" bpmnElement="BoundaryError_Tastefejl">
        <dc:Bounds x="784" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="682" y="342" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Loenfejl_di" bpmnElement="EndEvent_Loenfejl">
