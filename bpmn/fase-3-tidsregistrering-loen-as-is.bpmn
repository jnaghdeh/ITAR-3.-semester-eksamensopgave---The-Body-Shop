      <bpmndi:BPMNShape id="Activity_NoterTimer_di" bpmnElement="Activity_NoterTimer">
        <dc:Bounds x="335" y="135" width="160" height="90" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Maanedsslut_di" bpmnElement="Event_Maanedsslut">
        <dc:Bounds x="397" y="417" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="369" y="460" width="92" height="40" />
