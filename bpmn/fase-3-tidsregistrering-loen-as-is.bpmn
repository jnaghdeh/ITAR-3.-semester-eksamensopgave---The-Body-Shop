        <bpmndi:BPMNLabel>
          <dc:Bounds x="929" y="303" width="140" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_UdskiftKalender_di" bpmnElement="Activity_UdskiftKalender">
        <dc:Bounds x="940" y="390" width="155" height="90" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LoenKlargjort_di" bpmnElement="EndEvent_LoenKlargjort">
        <dc:Bounds x="1155" y="417" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1127" y="460" width="92" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObjectRef_Papirkalender3_di" bpmnElement="DataObjectRef_Papirkalender3">
        <dc:Bounds x="577" y="155" width="36" height="50" />
